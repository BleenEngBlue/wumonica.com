# ============================================================
# wumonica.com/case-studies/.htaccess
# Case-study CSS and JS keep fixed filenames (not hashed like /_next/),
# so they must be revalidated instead of cached for a year.
# Everything else (HTTPS redirect, CSP and other security headers, dotfile
# blocking, compression, 404 page) is inherited from the root .htaccess.
# ============================================================
<IfModule mod_headers.c>
  # Overrides the root rule "public, max-age=31536000, immutable" for these files only.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Fonts rarely change: cache for 30 days, not forever (they have fixed filenames too).
  <FilesMatch "\.ttf$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
